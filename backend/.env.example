# Copy to backend/.env and fill in. This file is gitignored — the real one must
# never be committed, since the connection string is a credential.

# Neon: Dashboard > your project > Connect > "Connection string" (pooled).
# It already ends with ?sslmode=require — keep that.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Only for a database using a self-signed certificate. Neon does not need this.
# PGSSL_NO_VERIFY=1

# Used once, by `npm run seed`, to create the first administrator.
ADMIN_EMAIL=you@digibuggy.com
ADMIN_PASSWORD=a long passphrase, not a short password

# PORT=3000
